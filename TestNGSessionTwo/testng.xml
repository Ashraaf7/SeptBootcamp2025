<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Login Suite">
    <test name="Login Test On Edge">
        <parameter name="browser" value="edge"></parameter>
        <classes>
            <class name="Assertions">
                <methods>
                    <exclude name="validLogin"></exclude>
                </methods>
            </class>
            <class name="Annotations">
                <methods>
                    <include name="testCase1"></include>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Login Test On Chrome">
        <parameter name="browser" value="chrome"></parameter>
        <classes>
            <class name="Assertions">
                <methods>
                    <exclude name="validLogin"></exclude>
                </methods>
            </class>
            <class name="Annotations">
                <methods>
                    <include name="testCase1"></include>
                </methods>
            </class>
        </classes>
    </test>
</suite>


